// This file is part of www.nand2tetris.org
// and the book "The Elements of Computing Systems"
// by Nisan and Schocken, MIT Press.
// File name: projects/05/CPU.hdl

CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current
                         // program (reset==1) or continue executing
                         // the current program (reset==0).

    OUT outM[16],        // M value output
        writeM,          // Write to M? 
        addressM[15],    // Address in data memory (of M)
        pc[15];          // address of next instruction

    PARTS:
    // Decode instruction type: instruction[15] == 0 -> A-instruction, 1 -> C-instruction
    Not(in=instruction[15], out=aInst);
    Not(in=aInst, out=cInst);

    // Select input for A-register: instruction (if A-inst) or ALU output (if C-inst with d1=1)
    And(a=cInst, b=instruction[5], out=aluToA);
    Mux16(a=instruction, b=aluOut, sel=aluToA, out=aRegIn);

    // Load A-register if A-instruction OR (C-instruction AND d1=instruction[5])
    Or(a=aInst, b=aluToA, out=loadA);
    ARegister(in=aRegIn, load=loadA, out=aRegOut, out[0..14]=addressM);

    // Select second ALU input (y): A-register (a=instruction[12]==0) or inM (a=1)
    And(a=cInst, b=instruction[12], out=selM);
    Mux16(a=aRegOut, b=inM, sel=selM, out=aluY);

    // Load D-register if C-instruction AND d2=instruction[4]
    And(a=cInst, b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=dRegOut);

    // ALU execution using control bits c1..c6 (instruction[11..6])
    ALU(x=dRegOut, y=aluY,
        zx=instruction[11], nx=instruction[10],
        zy=instruction[9],  ny=instruction[8],
        f=instruction[7],   no=instruction[6],
        out=aluOut, out=outM, zr=zr, ng=ng);

    // Write to memory if C-instruction AND d3=instruction[3]
    And(a=cInst, b=instruction[3], out=writeM);

    // Jump logic evaluation
    Or(a=zr, b=ng, out=zrOrNg);
    Not(in=zrOrNg, out=pos); // pos = !zr & !ng (strictly > 0)

    And(a=instruction[0], b=pos, out=jgt);
    And(a=instruction[1], b=zr,  out=jeq);
    And(a=instruction[2], b=ng,  out=jlt);

    Or(a=jgt, b=jeq, out=jge);
    Or(a=jge, b=jlt, out=jumpCond);
    And(a=cInst, b=jumpCond, out=pcLoad);

    // Program Counter: reset > jump > increment
    PC(in=aRegOut, load=pcLoad, inc=true, reset=reset, out[0..14]=pc);
}
